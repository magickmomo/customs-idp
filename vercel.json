{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "rewrites":[
    {"source":"/api/outlook/webhook","destination":"/api/outlook?action=webhook"}
  ],
  "crons":[
    {"path":"/api/outlook?action=renew","schedule":"0 3 * * *"},
    {"path":"/api/outlook?action=process-webhook","schedule":"* * * * *"}
  ]
}
